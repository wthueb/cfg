loki.relabel "journal" {
	forward_to = []

	rule {
		source_labels = ["__journal__systemd_unit"]
		target_label  = "unit"
	}

	// nginx.service             -> nginx
	// postgresql.service        -> postgresql
	// getty@tty1.service        -> getty
	// sshd@192.168.1.5.service  -> sshd
	rule {
		source_labels = ["__journal__systemd_unit"]
		regex         = `^([^@]+)(?:@.*)?\.service$`
		replacement   = "$1"
		target_label  = "service_name"
	}
}

loki.source.journal "journal" {
	relabel_rules = loki.relabel.journal.rules
	forward_to    = [loki.process.strip_ansi.receiver]
	labels        = {
		job = "journal",
	}
}

// strip ANSI colour codes
loki.process "strip_ansi" {
	forward_to = [loki.process.detect_level.receiver]

	stage.replace {
		expression = `(\x1b\[[\d;]*m)`
		replace    = ""
	}
}

loki.process "detect_level" {
	forward_to = [loki.process.normalize_level.receiver]

	stage.match {
		selector = `{level=""}`

		stage.static_labels {
			values = {
				level = "unknown",
			}
		}
	}

	// json
	stage.match {
		selector = `{level="unknown"} |~ "^\\s*\\{"`

		stage.json {
			expressions = {
				level = `level || lvl || "@l"`,
			}
		}

		stage.labels {
			values = {
				level = "",
			}
		}
	}

	// logfmt
	stage.match {
		selector = `{level="unknown"} |~ "^\\s*[A-Za-z_][A-Za-z0-9_.-]*="`

		stage.logfmt {
			mapping = {
				level = "",
			}
		}

		stage.logfmt {
			mapping = {
				level = "lvl",
			}
		}

		stage.labels {
			values = {
				level = "",
			}
		}
	}

	// klog format (https://github.com/kubernetes/klog), e.g. I0119
	stage.match {
		selector = `{level="unknown"} |~ "([IWED]\\d{4}\\s+\\d{2}:\\d{2}:\\d{2}\\.\\d+)"`

		// klog uses a single-letter code followed by the month and day, i.e. I0119
		stage.regex {
			expression = `(?P<level>[A-Z])\d{4}`
		}

		stage.replace {
			source     = "level"
			expression = `(I)`
			replace    = "info"
		}

		stage.replace {
			source     = "level"
			expression = `(W)`
			replace    = "warn"
		}

		stage.replace {
			source     = "level"
			expression = `(E)`
			replace    = "error"
		}

		stage.replace {
			source     = "level"
			expression = `(D)`
			replace    = "debug"
		}

		stage.labels {
			values = {
				level = "",
			}
		}
	}

	// bracketed level, e.g. [INFO], [info]
	stage.match {
		selector = `{level="unknown"}`

		stage.regex {
			expression = `(?i)(^|\s)\[(?P<level>trace?|trc|(debug?|dbg)\d*|info?(mation(al)?)?|wa?rn(ing)?|err(or)?|fatal|ftl|crit(ical)?|panic|pnc)\]\s`
		}

		stage.labels {
			values = {
				level = "",
			}
		}
	}

	// ::LEVEL:: format
	stage.match {
		selector = `{level="unknown"}`

		stage.regex {
			expression = `(?i)::(?P<level>TRACE?|TRC|(DEBUG?|DBG)\d*|INFO?(MATION(AL)?)?|WA?RN(ING)?|ERR(OR)?|FATAL|FTL|CRIT(ICAL)?|PANIC|PNC)::`
		}

		stage.labels {
			values = {
				level = "",
			}
		}
	}

	// all caps levels by themselves
	stage.match {
		selector = `{level="unknown"}`

		stage.regex {
			expression = `(^|\s)(?P<level>TRACE?|TRC|(DEBUG?|DBG)\d*|INFO?(MATION(AL)?)?|WA?RN(ING)?|ERR(OR)?|FATAL|FTL|CRIT(ICAL)?|PANIC|PNC)($|\s)`
		}

		stage.labels {
			values = {
				level = "",
			}
		}
	}

	// redis logs
	stage.match {
		selector = `{level="unknown"} |~ "^\\d+:[A-Z] \\d{2} \\w+ \\d+ \\d{2}:\\d{2}:\\d{2}\\.\\d{3} [#*.\\-] .+$"`

		stage.regex {
			expression = `^(?P<pid>\d+):(?P<role>[A-Z]{1}) (?P<ts>\d{2} \w+ \d+ \d{2}:\d{2}:\d{2}\.\d{3}) (?P<level>[#*\-.]) (?P<msg>.+)$`
		}

		stage.timestamp {
			source            = "ts"
			format            = "02 Jan 2006 15:04:05.000"
			location          = "UTC"
			action_on_failure = "skip"
		}

		stage.template {
			source = "level"

			template = `{{- if eq .level "." -}} debug {{- else if eq .level "-" -}} info {{- else if eq .level "*" -}} info {{- else if eq .level "#" -}} warn {{- else -}} unknown {{- end -}}`
		}

		stage.labels {
			values = {
				level = "",
			}
		}

		stage.template {
			source   = "json"
			template = `{{- if .pid -}}
			{"ts":{{ .ts | toJson }},"level":{{ .level | toJson }},"pid":{{ .pid | toJson }},"role":{{ .role | toJson }},"msg":{{ .msg | toRawJson }}}
			{{- else -}}
			{"msg":{{ .Entry | toJson }},"parse_error":true}
			{{- end -}}`
		}

		stage.output {
			source = "json"
		}
	}
}

loki.process "normalize_level" {
	forward_to = [loki.write.default.receiver]

	stage.drop {
		older_than          = "167h"
		drop_counter_reason = "too_old_for_loki"
	}

	// bunyan (https://github.com/trentm/node-bunyan#levels)
	stage.match {
		selector = `{level=~"^[1-6]0$"}`

		stage.template {
			source   = "level"
			template = "{{ $l := printf \"%v\" .Value }}{{ if eq $l \"10\" }}trace{{ else if eq $l \"20\" }}debug{{ else if eq $l \"30\" }}info{{ else if eq $l \"40\" }}warn{{ else if eq $l \"50\" }}error{{ else if eq $l \"60\" }}fatal{{ else }}unknown{{ end }}"
		}

		stage.labels {
			values = {
				level = "",
			}
		}
	}

	// trace: trc, trac, trace
	stage.replace {
		source     = "level"
		expression = `(?i)(trace?|trc)\d*`
		replace    = "trace"
	}

	// debug: dbg, debu, debug, debug1..N
	stage.replace {
		source     = "level"
		expression = `(?i)(debug?|dbg)\d*`
		replace    = "debug"
	}

	// info: inf, info, information, informational
	stage.replace {
		source     = "level"
		expression = `(?i)(info?(mation(al)?)?)`
		replace    = "info"
	}

	// warning: wrn, warn, warning
	stage.replace {
		source     = "level"
		expression = `(?i)(wa?rn(ing)?)`
		replace    = "warn"
	}

	// error: err, error
	stage.replace {
		source     = "level"
		expression = `(?i)(err(or)?)`
		replace    = "error"
	}

	// fatal: ftl, fatal
	stage.replace {
		source     = "level"
		expression = `(?i)(fatal|ftl)`
		replace    = "fatal"
	}

	// critical: crit, critical, pnc, panic
	stage.replace {
		source     = "level"
		expression = `(?i)(crit(ical)?|panic|pnc)`
		replace    = "panic"
	}

	// lower-case anything else (notice, alert, emergency, ...)
	stage.template {
		source   = "level"
		template = "{{ ToLower .Value }}"
	}

	stage.labels {
		values = {
			level = "",
		}
	}
}
